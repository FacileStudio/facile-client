{
  "name": "@facile/client",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Fetch kernel, 401 redirect, session store and theme store for Facile SvelteKit clients",
  "type": "module",
  "svelte": "./src/lib/index.ts",
  "main": "./src/lib/index.ts",
  "exports": {
    ".": {
      "svelte": "./src/lib/index.ts",
      "types": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    },
    "./session": {
      "svelte": "./src/lib/session.svelte.ts",
      "types": "./src/lib/session.svelte.ts",
      "default": "./src/lib/session.svelte.ts"
    },
    "./theme": {
      "svelte": "./src/lib/theme.svelte.ts",
      "types": "./src/lib/theme.svelte.ts",
      "default": "./src/lib/theme.svelte.ts"
    },
    "./native": {
      "svelte": "./src/lib/native.ts",
      "types": "./src/lib/native.ts",
      "default": "./src/lib/native.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "src/lib",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "svelte-package --input src/lib --output dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/package": "^2.5.0",
    "@types/bun": "^1.3.14",
    "svelte": "^5.51.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "facile",
    "fetch",
    "session",
    "theme"
  ]
}
